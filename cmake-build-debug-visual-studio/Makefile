.PHONY : Spells\SpellData.cpp.s

Spells\SpellManager.obj: Spells\SpellManager.cpp.obj
.PHONY : Spells\SpellManager.obj

# target to build an object file
Spells\SpellManager.cpp.obj:
	$(MAKE) $(MAKESILENT) -f CMakeFiles\ConsoleRPG.dir\build.make /nologo -$(MAKEFLAGS) CMakeFiles\ConsoleRPG.dir\Spells\SpellManager.cpp.obj
.PHONY : Spells\SpellManager.cpp.obj

Spells\SpellManager.i: Spells\SpellManager.cpp.i
.PHONY : Spells\SpellManager.i

# target to preprocess a source file
Spells\SpellManager.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles\ConsoleRPG.dir\build.make /nologo -$(MAKEFLAGS) CMakeFiles\ConsoleRPG.dir\Spells\SpellManager.cpp.i
.PHONY : Spells\SpellManager.cpp.i

Spells\SpellManager.s: Spells\SpellManager.cpp.s
.PHONY : Spells\SpellManager.s

# target to generate assembly for a file
Spells\SpellManager.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles\ConsoleRPG.dir\build.make /nologo -$(MAKEFLAGS) CMakeFiles\ConsoleRPG.dir\Spells\SpellManager.cpp.s
.PHONY : Spells\SpellManager.cpp.s

